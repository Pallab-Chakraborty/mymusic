# MyMusic settings. Copy this file to ".env.local" and fill in the values.
# NEVER put real values in this file, and never commit ".env.local".

# --- Supabase (Project Settings > API Keys / Data API) -----------------------
# Your project's address, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# The "publishable" key (starts with sb_publishable_). Safe for the browser
# ONLY because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- YouTube Data API v3 (Google Cloud Console > APIs & Services > Credentials)
# Server-side only. Do NOT prefix with NEXT_PUBLIC_. Restrict it to the
# "YouTube Data API v3" in Google Cloud.
YOUTUBE_API_KEY=your-youtube-api-key
